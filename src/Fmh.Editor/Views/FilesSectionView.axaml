<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:Fmh.Editor.Services"
             xmlns:vm="using:Fmh.Editor.ViewModels"
             x:Class="Fmh.Editor.Views.FilesSectionView"
             x:DataType="vm:FilesSectionViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <TextBlock Classes="hint" Text="{s:L editor.files.hint}" />
    </StackPanel>
    <ListBox DockPanel.Dock="Left" Width="240" ItemsSource="{Binding Files}" SelectedItem="{Binding File}" Margin="0,0,12,0" />
    <TreeView ItemsSource="{Binding Nodes}">
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Items}" x:DataType="vm:JsonNodeItem">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Name}" MinWidth="200" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Summary}" Classes="hint" VerticalAlignment="Center" />
            <TextBox Text="{Binding Value}" IsVisible="{Binding IsLeaf}" MinWidth="220" />
            <Button Content="{s:L editor.files.addItem}" Command="{Binding AddItemCommand}" IsVisible="{Binding IsArray}" Padding="8,2" />
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsObject}">
              <TextBox Text="{Binding NewField}" Watermark="{s:L editor.files.fieldName}" Width="120" />
              <TextBox Text="{Binding NewValue}" Watermark="{s:L editor.files.fieldValue}" Width="90" />
              <Button Content="{s:L editor.files.addField}" Command="{Binding AddFieldCommand}" Padding="8,2" />
            </StackPanel>
            <Button Content="✕" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" Padding="6,2" ToolTip.Tip="{s:L editor.files.remove}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
