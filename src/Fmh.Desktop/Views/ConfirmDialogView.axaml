<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.ConfirmDialogView"
             x:DataType="vm:ConfirmDialogViewModel">
  <Border Classes="card" MinWidth="400" MaxWidth="560" Padding="24">
    <StackPanel Spacing="14">
      <TextBlock Classes="h2" Text="{Binding Title}" />
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{s:L ui.no}" Command="{Binding NoCommand}" />
        <Button Classes="primary" Content="{s:L ui.yes}" Command="{Binding YesCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
