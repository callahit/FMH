<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.MatchTacticsView"
             x:DataType="vm:MatchTacticsViewModel">
  <Border Classes="card" Width="520" Padding="24">
    <StackPanel Spacing="8">
      <TextBlock Classes="h2" Text="{s:L match.tactics}" />
      <ItemsControl ItemsSource="{Binding Settings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChoiceSetting">
            <Grid ColumnDefinitions="170,*" Margin="0,3">
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Classes="muted" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
        <Button Content="{s:L ui.cancel}" Command="{Binding CancelCommand}" />
        <Button Classes="primary" Content="{s:L match.apply}" Command="{Binding ApplyCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
