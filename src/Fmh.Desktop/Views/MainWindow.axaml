<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fmh.Desktop.ViewModels"
        xmlns:s="using:Fmh.Desktop.Services"
        x:Class="Fmh.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{s:L app.windowTitle}"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen">
  <!-- Skalierung der ganzen Oberfläche (Einstellung Schriftgröße) -->
  <LayoutTransformControl LayoutTransform="{Binding UiTransform}">
    <Grid>
      <!-- Bei offenem Dialog ist der Bildschirm dahinter gesperrt: Tab bleibt im Dialog. -->
      <ContentControl Content="{Binding Screen}" IsEnabled="{Binding !HasDialog}" />
      <Border IsVisible="{Binding HasDialog}" Background="#99000000">
        <ContentControl x:Name="DialogHost" Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>
  </LayoutTransformControl>
</Window>
