<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:c="using:Fmh.Desktop.Controls"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.StadiumPageView"
             x:DataType="vm:StadiumPageViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <TextBlock Classes="h1" Text="{Binding StadiumTitle}" />
      <TextBlock Grid.Column="1" Text="{Binding Result}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                 VerticalAlignment="Bottom" Margin="18,0" TextWrapping="Wrap" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
        <TextBlock Text="{s:L build.contractor}" VerticalAlignment="Center" Classes="muted" />
        <ComboBox ItemsSource="{Binding Contractors}" SelectedIndex="{Binding ContractorIndex}" MinWidth="220" />
        <CheckBox Content="{s:L build.financed}" IsChecked="{Binding Financed}" />
      </StackPanel>
    </Grid>
    <TabControl>
      <TabItem Header="{s:L build.tab.stadium}">
        <ScrollViewer>
          <StackPanel Spacing="14">
            <Border Classes="card">
              <ItemsControl ItemsSource="{Binding StadiumFacts}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InfoLine">
                    <StackPanel Margin="0,6,16,6">
                      <TextBlock Text="{Binding Label}" Classes="muted small" />
                      <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding Fore}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <ItemsControl ItemsSource="{Binding Stands}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StandCard">
                  <Border Classes="card" Margin="0,0,14,14">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h3" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding Places}" FontWeight="Bold" FontSize="16" />
                      </Grid>
                      <c:Meter Value="{Binding Fill}" Maximum="1" Height="6" Fill="{DynamicResource AccentBrush}" Track="{DynamicResource LineBrush}" />
                      <TextBlock Text="{Binding Details}" Classes="muted small" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:BuildAction">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Cost}" Classes="small" />
                                <TextBlock Text="{Binding Impact}" Foreground="{Binding ImpactBrush}" FontSize="11" TextWrapping="Wrap" />
                              </StackPanel>
                              <Button Grid.Column="1" Content="{Binding Label}" Command="{Binding Command}" MinWidth="170" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Text="{s:L build.stadiumTech}" />
                <ItemsControl ItemsSource="{Binding StadiumActions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BuildAction">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Cost}" Classes="small" />
                          <TextBlock Text="{Binding Impact}" Foreground="{Binding ImpactBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding Label}" Command="{Binding Command}" MinWidth="200" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted small" Text="{s:L forecast.help}" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h3" Text="{s:L newStadium.title}" />
                <TextBlock Text="{Binding SiteText}" TextWrapping="Wrap" />
                <StackPanel Spacing="8" IsVisible="{Binding HasSite}">
                  <Grid ColumnDefinitions="200,220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                    <TextBlock Text="{s:L newStadium.capacity}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding DesignCapacity}" Minimum="10000" Maximum="{Binding DesignMax}" Increment="1000" FormatString="N0" />
                    <TextBlock Grid.Row="1" Text="{s:L newStadium.standing}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DesignStanding}" Minimum="0" Maximum="60" Increment="5" FormatString="N0" />
                    <TextBlock Grid.Row="2" Text="{s:L newStadium.boxes}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding DesignBoxes}" Minimum="0" Maximum="80" Increment="5" FormatString="N0" />
                    <TextBlock Grid.Row="3" Text="{s:L newStadium.name}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DesignName}" MaxLength="40" />
                    <CheckBox Grid.Row="4" Grid.Column="1" Content="{s:L newStadium.roof}" IsChecked="{Binding DesignRoof}" />
                  </Grid>
                  <TextBlock Text="{Binding DesignCost}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DesignImpact}" Foreground="{Binding DesignImpactBrush}" TextWrapping="Wrap" />
                  <Button Classes="primary" Content="{s:L newStadium.order}" Command="{Binding OrderNewStadiumCommand}" HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock Classes="muted small" Text="{s:L newStadium.help}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{s:L build.tab.grounds}">
        <Grid ColumnDefinitions="*,380" ColumnSpacing="14">
          <Border Classes="card" Padding="10">
            <DockPanel>
              <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Text="{Binding GroundsText}" Classes="muted small" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{s:L build.buyLand}" Command="{Binding BuyLandCommand}" />
              </Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tiles}" Width="{Binding GridWidth}" Height="{Binding GridHeight}" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:GroundTile">
                      <Setter Property="Canvas.Left" Value="{Binding Left}" />
                      <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    </Style>
                  </ItemsControl.Styles>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroundTile">
                      <Button Width="{Binding Width}" Height="{Binding Height}" Padding="3" Command="{Binding Select}" Classes="tile"
                              Background="{Binding Fill}" BorderBrush="{Binding Border}" BorderThickness="2" CornerRadius="6"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="{Binding Label}">
                        <StackPanel>
                          <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" MaxLines="3" />
                          <TextBlock Text="{Binding Sub}" FontSize="9" Foreground="White" Opacity="0.8" TextAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Spacing="6">
                <TextBlock Classes="h3" Text="{Binding SelectionTitle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" Classes="small" />
                <StackPanel Spacing="6" IsVisible="{Binding HasBuilding}" Margin="0,6,0,0">
                  <Button Classes="primary" Content="{Binding UpgradeText}" Command="{Binding UpgradeCommand}" HorizontalAlignment="Stretch" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding LeaseText}" Command="{Binding LeaseCommand}" />
                    <Button Content="{s:L build.demolish}" Command="{Binding DemolishCommand}" />
                  </StackPanel>
                </StackPanel>
                <ComboBox ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryIndex}" HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsFreeCell}" Margin="0,6,0,0" />
              </StackPanel>
              <ScrollViewer IsVisible="{Binding IsFreeCell}" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding BuildOptions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BuildOption">
                      <Border Classes="inset" Margin="0,0,0,6" Padding="10">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Category}" Classes="muted small" />
                            <TextBlock Text="{Binding Effects}" Classes="small" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Upkeep}" Classes="muted small" />
                            <TextBlock Text="{Binding Hint}" Classes="muted small" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Cost}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            <Button Content="{s:L build.build}" Command="{Binding Build}" IsEnabled="{Binding Possible}" HorizontalAlignment="Right" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{s:L build.tab.projects}">
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Classes="muted" Text="{s:L build.noProjects}" IsVisible="{Binding NoProjects}" />
            <ItemsControl ItemsSource="{Binding Projects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectLine">
                  <Grid ColumnDefinitions="*,200,160,130" Margin="0,3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{Binding Brush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Dates}" Classes="muted" />
                    <TextBlock Grid.Column="3" Text="{Binding Cost}" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
