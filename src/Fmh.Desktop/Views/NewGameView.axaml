<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:c="using:Fmh.Desktop.Controls"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.NewGameView"
             x:DataType="vm:NewGameViewModel">
  <DockPanel Margin="32,24">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,18">
      <Button Classes="ghost" Command="{Binding BackCommand}" Padding="6">
        <Path Classes="icon" Data="{StaticResource IconBack}" />
      </Button>
      <TextBlock Grid.Column="1" Classes="h1" Text="{s:L newGame.title}" VerticalAlignment="Center" Margin="8,0" />
    </Grid>

    <Grid ColumnDefinitions="*,380" ColumnSpacing="20">
      <!-- Vereinsauswahl -->
      <Border Classes="card" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h3" Text="{s:L newGame.chooseClub}" Margin="6,0,0,10" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Clubs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClubChoice">
                  <Button Classes="ghost" Padding="0" Margin="4"
                          Command="{Binding $parent[ItemsControl].((vm:NewGameViewModel)DataContext).SelectClubCommand}" CommandParameter="{Binding}">
                    <Border Width="200" Height="76" CornerRadius="10" Padding="10" BorderThickness="2"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{Binding IsSelected, Converter={x:Static s:Converters.SelectedBorder}}">
                      <Grid ColumnDefinitions="Auto,*">
                        <c:Crest Width="44" Height="52" Primary="{Binding Primary}" Secondary="{Binding Secondary}" Initials="{Binding Initials}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Info}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                          <c:Meter Value="{Binding Reputation}" Maximum="20" Height="6" Width="110" HorizontalAlignment="Left"
                                   Fill="{DynamicResource GoldBrush}" Track="{DynamicResource LineBrush}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Einstellungen und gewählter Verein -->
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="14">
          <Border Classes="card">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
              <c:Crest Width="110" Height="126" Primary="{Binding Selected.Primary}" Secondary="{Binding Selected.Secondary}" Initials="{Binding Selected.Initials}" HorizontalAlignment="Center" />
              <TextBlock Classes="h2" Text="{Binding Selected.Name}" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding Selected.Info}" HorizontalAlignment="Center" />
              <TextBlock Classes="muted small" Text="{Binding StadiumInfo}" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Expectation}" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="h3" Text="{s:L newGame.name}" />
              <TextBox Text="{Binding ManagerName}" MaxLength="24" />
              <TextBlock Classes="h3" Text="{s:L newGame.background}" Margin="0,6,0,0" />
              <ComboBox ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding SelectedBackground}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="muted small" Text="{Binding BackgroundInfo}" TextWrapping="Wrap" />
              <TextBlock Classes="h3" Text="{s:L newGame.injuryRule}" Margin="0,6,0,0" />
              <ComboBox ItemsSource="{Binding InjuryOptions}" SelectedItem="{Binding SelectedInjury}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h3" Text="{s:L newGame.seed}" />
                  <TextBox Text="{Binding Seed}" MaxLength="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Classes="h3" Text="{s:L newGame.ironman}" />
                  <ToggleSwitch IsChecked="{Binding Ironman}" OnContent="{s:L ui.yes}" OffContent="{s:L ui.no}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Button Classes="primary" Content="{s:L newGame.start}" Command="{Binding StartCommand}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Padding="16,14" FontSize="16" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
