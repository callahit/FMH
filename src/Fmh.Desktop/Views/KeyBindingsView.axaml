<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.KeyBindingsView"
             x:DataType="vm:KeyBindingsViewModel">
  <Border Classes="card" Width="520" Padding="24">
    <StackPanel Spacing="10">
      <TextBlock Classes="h2" Text="{s:L keys.title}" />
      <TextBlock Classes="muted small" Text="{s:L keys.hint}" TextWrapping="Wrap" />
      <ScrollViewer MaxHeight="460">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KeyBindingRow">
              <Grid ColumnDefinitions="*,150" Margin="0,2">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Classes="muted" />
                <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Classes.primary="{Binding IsCapturing}" Content="{Binding Gesture}"
                        AutomationProperties.Name="{Binding Label}"
                        Command="{Binding $parent[ItemsControl].((vm:KeyBindingsViewModel)DataContext).CaptureCommand}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource GoldBrush}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{s:L keys.reset}" Command="{Binding ResetCommand}" />
        <Button Classes="primary" Content="{s:L ui.ok}" Command="{Binding CloseCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
