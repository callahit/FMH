<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.OptionsView"
             x:DataType="vm:OptionsViewModel">
  <Border Classes="card" Width="560" Padding="24">
    <StackPanel Spacing="10">
      <TextBlock Classes="h2" Text="{Binding Title}" />
      <TextBlock Classes="h3" Text="{s:L options.personal}" Margin="0,6,0,0" />
      <ItemsControl ItemsSource="{Binding Settings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChoiceSetting">
            <Grid ColumnDefinitions="200,*" Margin="0,3">
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Classes="muted" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="h3" Text="{s:L options.world}" Margin="0,10,0,0" />
      <ItemsControl ItemsSource="{Binding World}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InfoLine">
            <Grid ColumnDefinitions="200,*" Margin="0,3">
              <TextBlock Text="{Binding Label}" Classes="muted" />
              <TextBlock Grid.Column="1" Text="{Binding Value}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="muted small" Text="{s:L options.worldHint}" TextWrapping="Wrap" />
      <Button Classes="primary" HorizontalAlignment="Right" Content="{s:L ui.ok}" Command="{Binding CloseCommand}" Margin="0,8,0,0" />
    </StackPanel>
  </Border>
</UserControl>
