<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.InboxPageView"
             x:DataType="vm:InboxPageViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding CountText}" VerticalAlignment="Bottom" />
    </Grid>
    <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16">
      <Border Classes="card" Padding="6">
        <ListBox ItemsSource="{Binding Messages}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageItem">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
                <Ellipse Width="9" Height="9" Fill="{Binding TypeBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="10,0">
                  <TextBlock Text="{Binding Subject}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Sender}" Classes="muted small" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Text="{Binding Date}" Classes="muted small" HorizontalAlignment="Right" />
                  <Border Classes="pill" Background="{DynamicResource WarnBrush}" IsVisible="{Binding Open}">
                    <TextBlock Text="{s:L inbox.decision}" Foreground="White" FontSize="11" FontWeight="Bold" />
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Border Grid.Column="1" Classes="card" Padding="24">
        <StackPanel Spacing="8" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Classes="h2" Text="{Binding Selected.Subject}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="9" Height="9" Fill="{Binding Selected.TypeBrush}" />
            <TextBlock Classes="muted small" Text="{Binding Selected.Sender}" />
            <TextBlock Classes="muted small" Text="{Binding Selected.FullDate}" />
          </StackPanel>
          <Separator Margin="0,6" />
          <TextBlock Text="{Binding Selected.Body}" TextWrapping="Wrap" LineHeight="22" />
          <Border Classes="inset" Margin="0,12,0,0" IsVisible="{Binding IsOffer}">
            <StackPanel Spacing="10">
              <TextBlock Classes="h3" Text="{s:L inbox.offerDecision}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="{s:L inbox.accept}" Command="{Binding AcceptOfferCommand}" />
                <Button Content="{s:L inbox.reject}" Command="{Binding RejectOfferCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <NumericUpDown Value="{Binding CounterFee}" Minimum="0" Increment="50000" FormatString="N0" Width="200" />
                <Button Content="{s:L inbox.counter}" Command="{Binding CounterOfferCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="inset" Margin="0,12,0,0" IsVisible="{Binding HasDecisions}">
            <StackPanel Spacing="8">
              <TextBlock Classes="h3" Text="{Binding DecisionTitle}" />
              <ItemsControl ItemsSource="{Binding Decisions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DecisionOption">
                    <Button Command="{Binding Command}" Classes.primary="{Binding Primary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,3">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Classes="small" Opacity="0.8" TextWrapping="Wrap"
                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="inset" Margin="0,12,0,0" IsVisible="{Binding IsPress}">
            <StackPanel Spacing="10">
              <TextBlock Classes="h3" Text="{Binding DecisionTitle}" />
              <ItemsControl ItemsSource="{Binding PressQuestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PressQuestionItem">
                    <StackPanel Spacing="4" Margin="0,4">
                      <TextBlock Text="{Binding Text}" FontStyle="Italic" TextWrapping="Wrap" />
                      <ComboBox ItemsSource="{Binding Answers}" SelectedIndex="{Binding Answer}" MinWidth="220" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="{s:L inbox.pressAnswer}" Command="{Binding AnswerPressCommand}" />
                <Button Content="{s:L inbox.pressDelegate}" Command="{Binding DelegatePressCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding ActionResult}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding ActionResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Button Content="{s:L inbox.openPlayer}" Command="{Binding OpenPlayerCommand}" IsVisible="{Binding CanOpenPlayer}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
