<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:c="using:Fmh.Desktop.Controls"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.SquadPageView"
             x:DataType="vm:SquadPageViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Summary}" VerticalAlignment="Bottom" Margin="18,0" />
      <ItemsControl Grid.Column="2" ItemsSource="{Binding Filters}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FilterOption">
            <Button Classes="chip" Content="{Binding Label}"
                    Command="{Binding $parent[ItemsControl].((vm:SquadPageViewModel)DataContext).SetFilterCommand}" CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Classes="muted small" Text="{s:L help.squad}" Margin="0,8,0,0" />
    <Border Classes="card" Padding="4">
      <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" DoubleTapped="OnDoubleTapped">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{s:L col.pos}" SortMemberPath="PositionOrder" Width="64">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:PlayerRow">
                <Border Classes="pill" Background="{DynamicResource Surface2Brush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                  <TextBlock Text="{Binding Position}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{s:L col.name}" Binding="{Binding Name}" Width="*" MinWidth="150" />
          <DataGridTextColumn Header="{s:L col.age}" Binding="{Binding Age}" Width="60" />
          <DataGridTemplateColumn Header="{s:L col.strength}" SortMemberPath="Strength" Width="84">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:PlayerRow">
                <Border Classes="pill" Background="{Binding StrengthBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                  <TextBlock Text="{Binding StrengthText}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{s:L col.condition}" SortMemberPath="Condition" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:PlayerRow">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0" VerticalAlignment="Center">
                  <c:Meter Width="60" Height="6" Value="{Binding Condition}" Fill="{Binding ConditionBrush}" Track="{DynamicResource LineBrush}" />
                  <TextBlock Text="{Binding ConditionText}" FontSize="12" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{s:L col.morale}" SortMemberPath="MoraleOrder" Width="96">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:PlayerRow">
                <TextBlock Text="{Binding Morale}" Foreground="{Binding MoraleBrush}" VerticalAlignment="Center" Margin="6,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{s:L col.form}" Binding="{Binding Form}" Width="64" />
          <DataGridTemplateColumn Header="{s:L col.status}" SortMemberPath="Status" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:PlayerRow">
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="6,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{s:L col.apps}" Binding="{Binding Apps}" Width="56" />
          <DataGridTextColumn Header="{s:L col.goals}" Binding="{Binding Goals}" Width="62" />
          <DataGridTextColumn Header="{s:L col.grade}" Binding="{Binding GradeText}" SortMemberPath="Grade" Width="66" />
          <DataGridTextColumn Header="{s:L col.contract}" Binding="{Binding ContractUntil}" SortMemberPath="ContractOrder" Width="92" />
          <DataGridTextColumn Header="{s:L col.wage}" Binding="{Binding Wage}" SortMemberPath="WageValue" Width="130" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
