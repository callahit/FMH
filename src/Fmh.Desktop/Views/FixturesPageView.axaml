<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:c="using:Fmh.Desktop.Controls"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.FixturesPageView"
             x:DataType="vm:FixturesPageViewModel">
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:FixtureVm">
      <Border Classes="inset" Margin="0,3" Padding="12,8">
        <Grid ColumnDefinitions="70,110,*,96,*,220">
          <TextBlock Text="{Binding Matchday}" Classes="muted small" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Date}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <TextBlock Text="{Binding HomeName}" VerticalAlignment="Center" FontWeight="{Binding Weight}" />
            <c:Crest Width="26" Height="30" Primary="{Binding Home.PrimaryColor}" Secondary="{Binding Home.SecondaryColor}" Initials="{Binding HomeInitials}" />
          </StackPanel>
          <Border Grid.Column="3" Background="{Binding ResultBrush}" CornerRadius="6" Padding="8,3" Margin="10,0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Result}" Foreground="White" FontWeight="Bold" />
          </Border>
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
            <c:Crest Width="26" Height="30" Primary="{Binding Away.PrimaryColor}" Secondary="{Binding Away.SecondaryColor}" Initials="{Binding AwayInitials}" />
            <TextBlock Text="{Binding AwayName}" VerticalAlignment="Center" FontWeight="{Binding Weight}" />
          </StackPanel>
          <TextBlock Grid.Column="5" Text="{Binding Detail}" Classes="muted small" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Season}" VerticalAlignment="Bottom" Margin="16,0" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <ToggleButton IsChecked="{Binding FriendlyView}" Content="{s:L friendly.title}" />
        <ToggleButton IsChecked="{Binding LeagueView}" Content="{s:L fixtures.leagueView}" />
      </StackPanel>
    </Grid>
    <Border Classes="card" Padding="12">
      <Panel>
        <ScrollViewer IsVisible="{Binding !LeagueView}">
          <ItemsControl ItemsSource="{Binding Own}" IsVisible="{Binding !FriendlyView}" />
        </ScrollViewer>
        <!-- Testspiele (AP 9) -->
        <DockPanel IsVisible="{Binding FriendlyView}">
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Classes="h2" Text="{s:L friendly.title}" />
            <TextBlock Classes="muted small" Text="{s:L friendly.info}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*,Auto,220" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
              <TextBlock Text="{s:L friendly.opponent}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Opponents}" SelectedItem="{Binding Opponent}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="2" Text="{s:L friendly.date}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="3" ItemsSource="{Binding FriendlyDates}" SelectedItem="{Binding FriendlyDate}" HorizontalAlignment="Stretch" />
              <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding FriendlyHome}" Content="{s:L friendly.home}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{s:L friendly.share}" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding Shares}" SelectedItem="{Binding Share}" MinWidth="80" />
                <Button Content="{s:L friendly.arrange}" Command="{Binding ArrangeFriendlyCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding FriendlyMessage}" TextWrapping="Wrap" />
            <TextBlock Classes="h2" Text="{s:L friendly.list}" Margin="0,8,0,0" />
            <TextBlock Classes="muted" Text="{s:L friendly.none}" IsVisible="{Binding NoFriendlies}" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Friendlies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FriendlyRowVm">
                  <Border Classes="inset" Margin="0,3" Padding="12,6">
                    <Grid ColumnDefinitions="110,*,220,Auto">
                      <TextBlock Text="{Binding Date}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Match}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted small" VerticalAlignment="Center" />
                      <Button Grid.Column="3" Content="{s:L friendly.cancel}" Command="{Binding Cancel}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
        <DockPanel IsVisible="{Binding LeagueView}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <Button Content="◄" Command="{Binding PreviousDayCommand}" />
            <TextBlock Grid.Column="1" Classes="h2" Text="{Binding DayTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="►" Command="{Binding NextDayCommand}" />
          </Grid>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Day}" />
          </ScrollViewer>
        </DockPanel>
      </Panel>
    </Border>
  </DockPanel>
</UserControl>
