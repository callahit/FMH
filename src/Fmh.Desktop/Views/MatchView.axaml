<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:c="using:Fmh.Desktop.Controls"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.MatchView"
             x:DataType="vm:MatchViewModel">
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:StatLine">
      <Grid ColumnDefinitions="70,*,70" Margin="0,5">
        <TextBlock Text="{Binding Home}" FontWeight="SemiBold" HorizontalAlignment="Left" />
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock Text="{Binding Label}" Classes="muted small" HorizontalAlignment="Center" />
          <c:CompareBar Left="{Binding HomeValue}" Right="{Binding AwayValue}" Height="8"
                        LeftBrush="{Binding $parent[UserControl].((vm:MatchViewModel)DataContext).HomeBrush}"
                        RightBrush="{Binding $parent[UserControl].((vm:MatchViewModel)DataContext).AwayBrush}"
                        Track="{DynamicResource LineBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Away}" FontWeight="SemiBold" HorizontalAlignment="Right" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:DataType="vm:GradeLine">
      <Grid ColumnDefinitions="40,*,Auto,44" Margin="0,3">
        <TextBlock Text="{Binding Position}" Classes="muted small" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Notes}" Foreground="{DynamicResource GoldBrush}" Classes="small" Margin="6,0" VerticalAlignment="Center" />
        <Border Grid.Column="3" Classes="pill" Background="{Binding GradeBrush}">
          <TextBlock Text="{Binding Grade}" Foreground="#101010" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Anzeigetafel -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16">
          <TextBlock Text="{Binding Home.Name}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
          <c:Crest Width="64" Height="74" Primary="{Binding Home.PrimaryColor}" Secondary="{Binding Home.SecondaryColor}" Initials="{Binding HomeInitials}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="36,0" VerticalAlignment="Center">
          <Border Background="{DynamicResource BgBrush}" CornerRadius="10" Padding="22,4" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Score}" FontSize="40" FontWeight="Black" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding Clock}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
          <TextBlock Text="{Binding Subline}" Classes="muted small" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
          <c:Crest Width="64" Height="74" Primary="{Binding Away.PrimaryColor}" Secondary="{Binding Away.SecondaryColor}" Initials="{Binding AwayInitials}" />
          <TextBlock Text="{Binding Away.Name}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Vorbericht -->
    <Panel Grid.Row="1" IsVisible="{Binding IsPreMatch}" Margin="22,18">
      <ContentControl Content="{Binding Editor}" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Grid ColumnDefinitions="*,*,340" ColumnSpacing="16" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="{s:L match.preview}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Preview}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InfoLine">
                  <Grid ColumnDefinitions="170,*" Margin="0,4">
                    <TextBlock Text="{Binding Label}" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="{s:L match.lineupCheck}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Checks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AdviceVm">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                    <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,6,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h3" Text="{s:L match.display}" />
            <ComboBox ItemsSource="{Binding DisplayModes}" SelectedIndex="{Binding DisplayModeIndex}" HorizontalAlignment="Stretch" />
            <TextBlock Classes="h3" Text="{s:L options.matchSpeed}" />
            <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Speed}" />
            <Button Content="{s:L match.editTactics}" Command="{Binding EditTacticsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="{s:L match.repair}" Command="{Binding RepairLineupCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Classes="primary" Command="{Binding KickoffCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,14" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="{StaticResource IconWhistle}" Stroke="#0B1A12" />
                <TextBlock Text="{s:L match.kickoff}" Foreground="#0B1A12" FontSize="16" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Panel>
    <Button Grid.Row="1" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}" Content="{s:L match.backToPreview}"
            Command="{Binding EditTacticsCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0" />

    <!-- Live und Halbzeit -->
    <Grid Grid.Row="1" IsVisible="{Binding IsLiveOrHalf}" Margin="22,16" ColumnDefinitions="2*,1.3*,1*" ColumnSpacing="16">
      <Border Classes="card" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h3" Text="{s:L match.commentary}" Margin="6,0,0,8" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Ticker}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TickerLine">
                  <Grid ColumnDefinitions="6,56,*" Margin="0,3">
                    <Border Width="4" CornerRadius="2" Background="{Binding Marker}" />
                    <TextBlock Grid.Column="1" Text="{Binding Minute}" Classes="mono muted" HorizontalAlignment="Right" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="14">
        <Border Classes="card">
          <ItemsControl ItemsSource="{Binding Stats}" />
        </Border>
        <Border Classes="card" IsVisible="{Binding IsConference}">
          <StackPanel Spacing="4">
            <TextBlock Classes="h3" Text="{s:L match.conference}" />
            <ItemsControl ItemsSource="{Binding ConferenceGames}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConferenceLine">
                  <Grid ColumnDefinitions="*,54,*" Margin="0,2">
                    <TextBlock Text="{Binding Home}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="1" Text="{Binding Score}" Foreground="{Binding Brush}" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Away}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding HasLiveTable}">
          <StackPanel Spacing="2">
            <TextBlock Classes="h3" Text="{s:L match.liveTable}" />
            <ItemsControl ItemsSource="{Binding LiveTable}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LiveTableRow">
                  <Grid ColumnDefinitions="30,*,60,36" Margin="0,1">
                    <TextBlock Text="{Binding Position}" Classes="muted small" />
                    <TextBlock Grid.Column="1" Text="{Binding Club}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}" Classes="small" />
                    <TextBlock Grid.Column="2" Text="{Binding Goals}" Classes="muted small" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{Binding Points}" FontWeight="{Binding Weight}" Classes="small" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="card" Height="170" IsVisible="{Binding !IsConference}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="h3" Text="{s:L match.xgTimeline}" />
            <c:LineChart SeriesA="{Binding XgSeriesHome}" SeriesB="{Binding XgSeriesAway}" MarkersA="{Binding GoalMarksHome}" MarkersB="{Binding GoalMarksAway}"
                         Step="True" MaxX="90" MaxY="1" BrushA="{Binding HomeBrush}" BrushB="{Binding AwayBrush}" GridBrush="{DynamicResource LineBrush}" />
          </DockPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
      <Border Grid.Column="2" Classes="card" Padding="12">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Classes="h3" Text="{s:L match.ownPlayers}" />
            <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding SubsLeft}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Players}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LivePlayer">
                <Grid ColumnDefinitions="34,*,70,Auto,38" Margin="0,4">
                  <TextBlock Text="{Binding Position}" Classes="muted small" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Marks}" Foreground="{DynamicResource GoldBrush}" Classes="small" VerticalAlignment="Center" />
                  </StackPanel>
                  <c:Meter Grid.Column="2" Height="6" Value="{Binding Condition}" Fill="{Binding ConditionBrush}" Track="{DynamicResource LineBrush}" />
                  <TextBlock Grid.Column="3" Text="{Binding Condition, StringFormat={}{0:0}}" Classes="muted small" Margin="6,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding Grade}" Foreground="{Binding GradeBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Kabinenansprache -->
    <Border Grid.Row="1" Background="#88000000" IsVisible="{Binding IsTalk}">
      <Border Classes="card" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{Binding TalkTitle}" />
          <TextBlock Classes="muted" Text="{s:L match.chooseTone}" />
          <ItemsControl ItemsSource="{Binding Tones}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ToneOption">
                <Button Margin="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10"
                        Command="{Binding $parent[ItemsControl].((vm:MatchViewModel)DataContext).TalkCommand}" CommandParameter="{Binding}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="pill" Background="{DynamicResource Surface2Brush}"><TextBlock Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center" /></Border>
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Hint}" Classes="muted small" TextWrapping="Wrap" Margin="0,3,0,0" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Border>

    <!-- Nachbericht -->
    <Grid Grid.Row="1" IsVisible="{Binding IsPostMatch}" Margin="22,16" ColumnDefinitions="*,*,1.1*,0.9*" ColumnSpacing="14">
      <Border Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h3" Text="{Binding Home.Name}" Margin="0,0,0,8" />
          <ScrollViewer><ItemsControl ItemsSource="{Binding HomeGrades}" /></ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h3" Text="{Binding Away.Name}" Margin="0,0,0,8" />
          <ScrollViewer><ItemsControl ItemsSource="{Binding AwayGrades}" /></ScrollViewer>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="2">
        <StackPanel Spacing="12">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding PlayerOfTheMatch}" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PostInfo}" Classes="muted small" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card"><ItemsControl ItemsSource="{Binding Stats}" /></Border>
          <Border Classes="card" Height="160">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="h3" Text="{s:L match.xgTimeline}" />
              <c:LineChart SeriesA="{Binding XgSeriesHome}" SeriesB="{Binding XgSeriesAway}" MarkersA="{Binding GoalMarksHome}" MarkersB="{Binding GoalMarksAway}"
                           Step="True" MaxX="90" MaxY="1" BrushA="{Binding HomeBrush}" BrushB="{Binding AwayBrush}" GridBrush="{DynamicResource LineBrush}" />
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="3">
        <StackPanel Spacing="12">
          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Classes="h3" Text="{s:L match.heatmapTitle}" />
              <c:Heatmap Height="300" Width="214" Values="{Binding Heat}" Grass="{DynamicResource PitchBrush}" Lines="{DynamicResource PitchLineBrush}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Classes="h3" Text="{s:L match.otherResultsTitle}" />
              <ItemsControl ItemsSource="{Binding OtherResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ResultLine">
                    <Grid ColumnDefinitions="*,54,*" Margin="0,2">
                      <TextBlock Text="{Binding Home}" FontWeight="{Binding Weight}" Classes="small" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Score}" FontWeight="Bold" Classes="small" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Away}" FontWeight="{Binding Weight}" Classes="small" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding TableInfo}" Classes="muted small" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Steuerleiste -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10">
      <Panel>
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="{Binding IsLiveOrHalf}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding TogglePauseCommand}" ToolTip.Tip="{s:L tip.pause}" IsVisible="{Binding !IsHalfTime}">
              <Panel>
                <Path Classes="icon" Data="{StaticResource IconPause}" IsVisible="{Binding !Paused}" />
                <Path Classes="icon" Data="{StaticResource IconPlay}" Fill="{DynamicResource TextBrush}" IsVisible="{Binding Paused}" />
              </Panel>
            </Button>
            <Button Classes="primary" Content="{s:L match.secondHalf}" Command="{Binding SecondHalfCommand}" IsVisible="{Binding IsHalfTime}" />
            <TextBlock Text="{s:L match.tempo}" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />
            <Slider Width="150" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Speed}" VerticalAlignment="Center" />
            <ToggleButton IsChecked="{Binding TickerMode}" Content="{s:L match.tickerOnly}" Command="{Binding ToggleTickerCommand}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="18,0">
            <Button Command="{Binding SubstituteCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconSwap}" Width="16" Height="16" /><TextBlock Text="{s:L match.substitution}" /></StackPanel>
            </Button>
            <Button Command="{Binding ChangeTacticsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconTactics}" Width="16" Height="16" /><TextBlock Text="{s:L match.tacticsButton}" /></StackPanel>
            </Button>
            <Button Command="{Binding ShoutOutCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconMegaphone}" Width="16" Height="16" /><TextBlock Text="{s:L match.shoutButton}" /></StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="4" Content="{s:L match.finishNow}" Command="{Binding FinishNowCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsPostMatch}">
          <TextBlock Text="{Binding TableInfo}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="primary" Content="{s:L match.done}" Command="{Binding CloseCommand}" Padding="22,10" />
        </Grid>
      </Panel>
    </Border>
  </Grid>
</UserControl>
