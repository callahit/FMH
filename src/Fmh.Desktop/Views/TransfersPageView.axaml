<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.TransfersPageView"
             x:DataType="vm:TransfersPageViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <Border Grid.Column="1" Classes="pill" Background="{Binding WindowBrush}" Margin="18,0" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="10,3">
        <TextBlock Text="{Binding WindowText}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
      </Border>
      <ItemsControl Grid.Column="2" ItemsSource="{Binding Budget}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InfoLine">
            <StackPanel>
              <TextBlock Text="{Binding Label}" Classes="muted small" />
              <TextBlock Text="{Binding Value}" Foreground="{Binding Fore}" FontWeight="SemiBold" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Classes="muted small" Text="{s:L help.transfers}" Margin="0,8,0,0" />

    <TabControl>
      <!-- Suche -->
      <TabItem Header="{s:L transfer.tab.search}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,10">
            <ItemsControl ItemsSource="{Binding Filters}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterOption">
                  <Button Classes="chip" Content="{Binding Label}"
                          Command="{Binding $parent[ItemsControl].((vm:TransfersPageViewModel)DataContext).SetFilterCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Leagues}" SelectedItem="{Binding League}" MinWidth="150">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ValueOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{s:L transfer.maxAge}" VerticalAlignment="Center" Classes="muted" />
              <NumericUpDown Value="{Binding MaxAge}" Minimum="15" Maximum="40" Increment="1" Width="110" />
            </StackPanel>
            <CheckBox Grid.Column="3" Content="{s:L transfer.onlyListed}" IsChecked="{Binding OnlyListed}" />
            <TextBox Grid.Column="4" Text="{Binding NameFilter}" Watermark="{s:L transfer.nameSearch}" />
            <TextBlock Grid.Column="5" Text="{Binding ResultInfo}" Classes="muted small" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="card" Padding="4">
            <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" DoubleTapped="OnDoubleTapped">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{s:L col.pos}" Binding="{Binding Position}" SortMemberPath="PositionOrder" Width="64" />
                <DataGridTextColumn Header="{s:L col.name}" Binding="{Binding Name}" Width="*" MinWidth="150" />
                <DataGridTextColumn Header="{s:L col.age}" Binding="{Binding Age}" Width="60" />
                <DataGridTextColumn Header="{s:L col.club}" Binding="{Binding Club}" Width="170" />
                <DataGridTemplateColumn Header="{s:L col.strength}" SortMemberPath="Strength" Width="84">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:TransferRow">
                      <Border Classes="pill" Background="{Binding StrengthBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                        <TextBlock Text="{Binding StrengthText}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{s:L col.knowledge}" Binding="{Binding Knowledge}" Width="100" />
                <DataGridTextColumn Header="{s:L col.value}" Binding="{Binding ValueText}" SortMemberPath="Value" Width="130" />
                <DataGridTextColumn Header="{s:L col.contract}" Binding="{Binding Contract}" SortMemberPath="ContractOrder" Width="92" />
                <DataGridTextColumn Header="{s:L col.report}" Binding="{Binding Report}" Width="90" />
                <DataGridTextColumn Header="{s:L col.flags}" Binding="{Binding Flags}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- Beobachtungsliste -->
      <TabItem Header="{s:L transfer.tab.shortlist}">
        <Border Classes="card" Padding="4" Margin="0,4,0,0">
          <Panel>
            <TextBlock Text="{s:L transfer.shortlistEmpty}" Classes="muted" Margin="12" IsVisible="{Binding !Shortlist.Count}" />
            <DataGrid ItemsSource="{Binding Shortlist}" SelectedItem="{Binding SelectedShortlist}" DoubleTapped="OnShortlistDoubleTapped">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{s:L col.pos}" Binding="{Binding Position}" SortMemberPath="PositionOrder" Width="64" />
                <DataGridTextColumn Header="{s:L col.name}" Binding="{Binding Name}" Width="*" MinWidth="150" />
                <DataGridTextColumn Header="{s:L col.age}" Binding="{Binding Age}" Width="60" />
                <DataGridTextColumn Header="{s:L col.club}" Binding="{Binding Club}" Width="170" />
                <DataGridTextColumn Header="{s:L col.strength}" Binding="{Binding StrengthText}" SortMemberPath="Strength" Width="84" />
                <DataGridTextColumn Header="{s:L col.knowledge}" Binding="{Binding Knowledge}" Width="100" />
                <DataGridTextColumn Header="{s:L col.value}" Binding="{Binding ValueText}" SortMemberPath="Value" Width="130" />
                <DataGridTextColumn Header="{s:L col.contract}" Binding="{Binding Contract}" SortMemberPath="ContractOrder" Width="92" />
                <DataGridTextColumn Header="{s:L col.report}" Binding="{Binding Report}" Width="90" />
              </DataGrid.Columns>
            </DataGrid>
          </Panel>
        </Border>
      </TabItem>

      <!-- Verhandlungen -->
      <TabItem Header="{s:L transfer.tab.negotiations}">
        <Border Classes="card" Margin="0,4,0,0">
          <Panel>
            <TextBlock Text="{s:L transfer.noNegotiations}" Classes="muted" IsVisible="{Binding !Negotiations.Count}" />
            <ItemsControl ItemsSource="{Binding Negotiations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NegotiationRow">
                  <Grid ColumnDefinitions="200,170,180,*,Auto" Margin="0,6" ColumnSpacing="12">
                    <TextBlock Text="{Binding Player}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Type}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Stage}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Response}" Classes="muted small" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="4" Content="{s:L transfer.continue}" IsVisible="{Binding CanOpen}"
                            Command="{Binding $parent[ItemsControl].((vm:TransfersPageViewModel)DataContext).ContinueNegotiationCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </Border>
      </TabItem>

      <!-- Scouts -->
      <TabItem Header="{s:L transfer.tab.scouts}">
        <StackPanel Spacing="12" Margin="0,4,0,0">
          <Border Classes="card">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{s:L scout.searchCriteria}" Classes="h3" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Leagues}" SelectedItem="{Binding SearchLeague}" MinWidth="150">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ValueOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox ItemsSource="{Binding SearchPositions}" SelectedItem="{Binding SearchPosition}" MinWidth="140">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ValueOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{s:L transfer.maxAge}" VerticalAlignment="Center" Classes="muted" />
              <NumericUpDown Value="{Binding SearchMaxAge}" Minimum="16" Maximum="40" Increment="1" Width="110" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Scouts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScoutRow">
                <Border Classes="card" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" Classes="h2" />
                      <TextBlock Text="{Binding Abilities}" Classes="muted small" />
                      <TextBlock Text="{Binding Assignment}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Content="{s:L scout.searchButton}" Classes="primary"
                              Command="{Binding $parent[ItemsControl].((vm:TransfersPageViewModel)DataContext).ScoutSearchCommand}" CommandParameter="{Binding}" />
                      <Button Content="{s:L scout.opponentButton}"
                              Command="{Binding $parent[ItemsControl].((vm:TransfersPageViewModel)DataContext).ScoutOpponentCommand}" CommandParameter="{Binding}" />
                      <Button Content="{s:L scout.cancel}" IsVisible="{Binding Busy}"
                              Command="{Binding $parent[ItemsControl].((vm:TransfersPageViewModel)DataContext).CancelScoutCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
      </TabItem>

      <!-- Historie -->
      <TabItem Header="{s:L transfer.tab.history}">
        <DockPanel Margin="0,4,0,0">
          <CheckBox DockPanel.Dock="Top" Content="{s:L transfer.onlyOwn}" IsChecked="{Binding OnlyOwnTransfers}" Margin="0,0,0,8" />
          <Border Classes="card" Padding="4">
            <DataGrid ItemsSource="{Binding History}" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{s:L col.date}" Binding="{Binding Date}" Width="110" />
                <DataGridTemplateColumn Header="{s:L col.name}" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:HistoryRow">
                      <TextBlock Text="{Binding Player}" Foreground="{Binding Brush}" VerticalAlignment="Center" Margin="6,0" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{s:L col.from}" Binding="{Binding From}" Width="170" />
                <DataGridTextColumn Header="{s:L col.to}" Binding="{Binding To}" Width="170" />
                <DataGridTextColumn Header="{s:L col.fee}" Binding="{Binding Fee}" Width="140" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
