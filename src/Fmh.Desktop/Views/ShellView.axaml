<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:c="using:Fmh.Desktop.Controls"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <DockPanel>
    <!-- Kopfzeile -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Background="{Binding HeaderBrush}" Height="74">
        <StackPanel Orientation="Horizontal" Margin="18,0" Spacing="14" VerticalAlignment="Center">
          <c:Crest Width="46" Height="54" Primary="{Binding ClubPrimary}" Secondary="{Binding ClubSecondary}" Initials="{Binding ClubInitials}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ClubName}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding LeagueText}" Classes="muted" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding DateText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding SeasonText}" Classes="muted small" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="18,0" VerticalAlignment="Center">
          <Button Classes="ghost" Command="{Binding SaveCommand}" ToolTip.Tip="{s:L tip.save}"><Path Classes="icon" Data="{StaticResource IconSave}" /></Button>
          <Button Classes="ghost" Command="{Binding OptionsCommand}" ToolTip.Tip="{s:L tip.options}"><Path Classes="icon" Data="{StaticResource IconSettings}" /></Button>
          <Button Classes="primary" Command="{Binding ContinueCommand}" Padding="22,12" Margin="8,0,0,0" ToolTip.Tip="{s:L tip.continue}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding ContinueText}" Foreground="#0B1A12" FontSize="15" />
              <Path Classes="icon" Data="{StaticResource IconFast}" Stroke="#0B1A12" Fill="#0B1A12" Width="14" Height="14" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Statuszeile -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,7">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <TextBlock Text="{Binding MoraleText}" Classes="small" />
        <TextBlock Grid.Column="1" Text="{Binding NextText}" Classes="small" Margin="24,0" />
        <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Classes="small" Foreground="{DynamicResource GoldBrush}" />
        <TextBlock Grid.Column="3" Text="{s:L help.shell}" Classes="muted small" />
      </Grid>
    </Border>

    <!-- Menü -->
    <Border DockPanel.Dock="Left" Width="210" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,14">
        <Button DockPanel.Dock="Bottom" Classes="nav" Command="{Binding MainMenuCommand}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="icon" Data="{StaticResource IconBack}" />
            <TextBlock Text="{s:L gameMenu.mainMenu}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ItemsControl ItemsSource="{Binding Nav}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Button Classes="nav" Classes.active="{Binding IsActive}" Classes.later="{Binding Later}" Margin="0,1"
                      Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Path Classes="icon" Data="{Binding Icon}" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Classes="muted small" VerticalAlignment="Center" Opacity="0.6" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Hauptbereich -->
    <ContentControl Content="{Binding Page}" Margin="22,18" />
  </DockPanel>
</UserControl>
