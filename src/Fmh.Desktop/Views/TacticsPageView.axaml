<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fmh.Desktop.ViewModels"
             xmlns:c="using:Fmh.Desktop.Controls"
             xmlns:s="using:Fmh.Desktop.Services"
             x:Class="Fmh.Desktop.Views.TacticsPageView"
             x:DataType="vm:TacticsPageViewModel">
  <UserControl.Styles>
    <Style Selector="ItemsControl.pitch > ContentPresenter" x:DataType="vm:SlotVm">
      <Setter Property="c:PitchPanel.X" Value="{Binding X}" />
      <Setter Property="c:PitchPanel.Y" Value="{Binding Y}" />
    </Style>
    <Style Selector="Border.entry">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.entry:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    </Style>
    <Style Selector="Border.entry.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Hint}" VerticalAlignment="Bottom" Margin="18,0" />
      <Button Grid.Column="2" Classes="chip" Content="{s:L tactics.auto}" Command="{Binding AutoPickCommand}" />
    </Grid>

    <Grid ColumnDefinitions="Auto,300,*" ColumnSpacing="16">
      <!-- Spielfeld -->
      <Border Classes="card" Padding="8" VerticalAlignment="Top">
        <Grid Width="440" Height="600">
          <c:Pitch Grass="{DynamicResource PitchBrush}" Lines="{DynamicResource PitchLineBrush}" />
          <ItemsControl Classes="pitch" ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:PitchPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SlotVm">
                <StackPanel Width="96" Spacing="2" Background="Transparent" Cursor="Hand" ToolTip.Tip="{Binding Tip}"
                            DragDrop.AllowDrop="True" Tapped="OnSlotTapped" PointerPressed="OnDragStart" PointerMoved="OnDragMove">
                  <Grid Width="52" Height="52" HorizontalAlignment="Center">
                    <Ellipse Width="52" Height="52" Stroke="{DynamicResource GoldBrush}" StrokeThickness="3" IsVisible="{Binding IsSelected}" />
                    <Ellipse Width="44" Height="44" Fill="{Binding ShirtBrush}" Stroke="{Binding RingBrush}" StrokeThickness="2.5" />
                    <TextBlock Text="{Binding Position}" Foreground="{Binding ShirtFore}" FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <Border Background="#B0000000" CornerRadius="5" Padding="5,1" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" MaxWidth="64" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding StrengthText}" Foreground="{Binding StrengthBrush}" FontSize="12" FontWeight="Bold" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <!-- Bank und Reserve -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
        <Border Classes="card" Padding="10" x:Name="BenchArea" DragDrop.AllowDrop="True">
          <StackPanel>
            <TextBlock Classes="h3" Text="{Binding BenchTitle}" Margin="4,0,0,6" />
            <ItemsControl ItemsSource="{Binding Bench}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SquadEntryVm">
                  <Border Classes="entry" Classes.selected="{Binding IsSelected}" Tapped="OnEntryTapped" DoubleTapped="OnEntryDoubleTapped"
                          PointerPressed="OnDragStart" PointerMoved="OnDragMove">
                    <Grid ColumnDefinitions="38,*,Auto,Auto">
                      <TextBlock Text="{Binding Position}" FontWeight="SemiBold" Classes="small" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border Grid.Column="2" Classes="pill" Background="{Binding StrengthBrush}" Margin="6,0">
                        <TextBlock Text="{Binding StrengthText}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                      </Border>
                      <Button Grid.Column="3" Classes="ghost" Padding="4,0" Content="✕" ToolTip.Tip="{s:L tip.removeBench}"
                              Command="{Binding $parent[ItemsControl].((vm:TacticsPageViewModel)DataContext).RemoveFromBenchCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Classes="card" Padding="10" x:Name="ReserveArea" DragDrop.AllowDrop="True">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="h3" Text="{s:L tactics.reserves}" Margin="4,0,0,6" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Reserves}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SquadEntryVm">
                    <Border Classes="entry" Tapped="OnEntryTapped" DoubleTapped="OnEntryDoubleTapped" PointerPressed="OnDragStart" PointerMoved="OnDragMove">
                      <Grid ColumnDefinitions="38,*,Auto">
                        <TextBlock Text="{Binding Position}" FontWeight="SemiBold" Classes="small" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" Classes="small" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="pill" Background="{Binding StrengthBrush}" Margin="6,0,0,0">
                          <TextBlock Text="{Binding StrengthText}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Anweisungen, Standards, Co-Trainer -->
      <ScrollViewer Grid.Column="2">
        <StackPanel Spacing="12">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Classes="h3" Text="{s:L tactics.instructions}" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceSetting">
                    <Grid ColumnDefinitions="150,*" Margin="0,3">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Classes="muted" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Classes="h3" Text="{s:L tactics.setPieces}" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding SetPieces}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceSetting">
                    <Grid ColumnDefinitions="150,*" Margin="0,3">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Classes="muted" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Classes="h3" Text="{s:L tactics.advice}" />
              <ItemsControl ItemsSource="{Binding Advice}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AdviceVm">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                      <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,6,8,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
