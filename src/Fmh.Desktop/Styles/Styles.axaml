<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Linien-Icons (24 x 24), werden mit Stroke gezeichnet -->
      <StreamGeometry x:Key="IconInbox">M3,5 H21 V19 H3 Z M3,13 H8 L10,16 H14 L16,13 H21</StreamGeometry>
      <StreamGeometry x:Key="IconSquad">M9,8 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 M2.5,20 C2.5,14 15.5,14 15.5,20 M16,4.6 a3.4,3.4 0 1,1 0,6.8 M18,14 C20.5,14.8 21.5,17 21.5,20</StreamGeometry>
      <StreamGeometry x:Key="IconTactics">M4,3 H20 V21 H4 Z M4,12 H20 M12,12 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M9,3 V6 H15 V3 M9,21 V18 H15 V21</StreamGeometry>
      <StreamGeometry x:Key="IconTraining">M6.5,7 V17 M3.5,9.5 V14.5 M17.5,7 V17 M20.5,9.5 V14.5 M6.5,12 H17.5</StreamGeometry>
      <StreamGeometry x:Key="IconFixtures">M4,6 H20 V20 H4 Z M4,10.5 H20 M8,3 V7.5 M16,3 V7.5 M8,14.5 H10 M14,14.5 H16 M8,17 H10</StreamGeometry>
      <StreamGeometry x:Key="IconTransfers">M4,8 H19 M15,4 L19,8 L15,12 M20,16 H5 M9,12 L5,16 L9,20</StreamGeometry>
      <StreamGeometry x:Key="IconFinances">M12,12 m-8.5,0 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0 M12,6.5 V17.5 M15,9 C14,7.2 9.2,7.3 9.2,9.8 C9.2,12.6 15,11.3 15,14.2 C15,16.8 10,16.9 9,15</StreamGeometry>
      <StreamGeometry x:Key="IconStadium">M3,9 C3,5 21,5 21,9 V16 C21,20.5 3,20.5 3,16 Z M3,9 C3,13 21,13 21,9 M8,12.3 V19.4 M16,12.3 V19.4 M12,12.8 V19.8</StreamGeometry>
      <StreamGeometry x:Key="IconClub">M12,3 L20,6 V12 C20,16.5 16.5,19.8 12,21 C7.5,19.8 4,16.5 4,12 V6 Z M8.5,10 H15.5 M8.5,13.5 H15.5</StreamGeometry>
      <StreamGeometry x:Key="IconLeague">M7,4 H17 V9 C17,13.5 7,13.5 7,9 Z M7,6 H4 C4,9.5 6,10.5 7.5,10.5 M17,6 H20 C20,9.5 18,10.5 16.5,10.5 M12,13 V17 M8,20.5 H16 M9.5,17 H14.5 V20.5 H9.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M12,12 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M12,2.5 V5.5 M12,18.5 V21.5 M2.5,12 H5.5 M18.5,12 H21.5 M5.3,5.3 L7.4,7.4 M16.6,16.6 L18.7,18.7 M18.7,5.3 L16.6,7.4 M7.4,16.6 L5.3,18.7</StreamGeometry>
      <StreamGeometry x:Key="IconSave">M5,3 H17 L21,7 V21 H3 V3 Z M7.5,3 V8 H15.5 V3 M7,21 V14 H17 V21</StreamGeometry>
      <StreamGeometry x:Key="IconPlay">M7,4.5 L19,12 L7,19.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPause">M8,5 V19 M16,5 V19</StreamGeometry>
      <StreamGeometry x:Key="IconBack">M15,5 L8,12 L15,19</StreamGeometry>
      <StreamGeometry x:Key="IconSwap">M7,4 V20 M4,7 L7,4 L10,7 M17,20 V4 M14,17 L17,20 L20,17</StreamGeometry>
      <StreamGeometry x:Key="IconWhistle">M3,10 H14 C17.5,10 20,12.5 20,15.5 C20,18.5 17.5,21 14.5,21 C11.5,21 9,18.5 9,15.5 V14 H3 Z M14.5,15.5 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 M12,10 V6 M15,6.5 L13.5,8.5 M9,6.5 L10.5,8.5</StreamGeometry>
      <StreamGeometry x:Key="IconMegaphone">M3,10 V14 H7 L15,19 V5 L7,10 Z M18,9 C19.5,10.5 19.5,13.5 18,15 M7,14 L9,20 H11</StreamGeometry>
      <StreamGeometry x:Key="IconFast">M3,6 L11,12 L3,18 Z M12,6 L20,12 L12,18 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBall">M12,12 m-8.5,0 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0 M12,8 L15.3,10.4 L14,14.3 H10 L8.7,10.4 Z M12,8 V3.5 M15.3,10.4 L20,9 M14,14.3 L16.5,18.5 M10,14.3 L7.5,18.5 M8.7,10.4 L4,9</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="DejaVu Sans Mono, Consolas, Menlo, monospace" />
  </Style>

  <!-- Karten -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="MinWidth" Value="28" />
  </Style>

  <!-- Icons -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Knöpfe -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#0B1A12" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#0B1A12" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.chip.selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#0B1A12" />
  </Style>

  <!-- Navigation links -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
  </Style>
  <Style Selector="Button.nav.active TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.active Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.nav.later TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- Listenzeilen -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="CanUserReorderColumns" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="SelectionMode" Value="Single" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
</Styles>
