          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "Match",
              "Negotiation"
            ]
          },
          "penalty": {
            "additionalProperties": false,
            "properties": {
              "board": {
                "maximum": 0,
                "minimum": -100,
                "type": "number"
              },
              "fine": {
