  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "description": "Vereinsdefinition im Datenpaket. Spieler werden beim Start erzeugt.",
    "properties": {
      "capacity": {
        "type": "integer"
      },
      "city": {
        "type": "string"
      },
      "division": {
        "type": "string"
      },
      "key": {
        "type": "string"
      },
      "latitude": {
        "type": [
          "number",
          "null"
        ]
      },
      "longitude": {
        "type": [
          "number",
          "null"
        ]
      },
      "name": {
        "type": "string"
      },
      "primaryColor": {
        "type": "string"
      },
