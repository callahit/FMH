{
  "$id": "https://fmh.local/schema/managers.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "description": "KI-Manager eines Vereins (Datei managers/*.json); übernimmt den Verein, den der Spieler verlässt.",
    "properties": {
      "age": {
        "maximum": 80,
        "minimum": 25,
        "type": "integer"
      },
      "club": {
        "description": "Verein (Schlüssel); leer = ohne Verein.",
        "type": "string"
      },
      "motivation": {
        "description": "Menschenführung 1–20; leer = 10.",
        "maximum": 20,
        "minimum": 1,
        "type": [
          "integer",
          "null"
        ]
      },
      "name": {
        "type": "string"
      },
      "nationality": {
        "description": "Ländercode der Herkunft.",
        "type": "string"
      },
      "reputation": {
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
      },
      "style": {
        "description": "Spielidee: wirkt auf Grundhaltung und Anweisungen der Mannschaft.",
        "enum": [
          "Balanced",
          "Attacking",
          "Defensive",
          "Counter",
          "Pressing"
        ]
      },
      "tactics": {
        "description": "Taktisches Können 1–20; leer = wie der Ruf.",
        "maximum": 20,
        "minimum": 1,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "title": "FMH managers/*.json",
  "type": "array"
}
